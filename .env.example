# Copy to .env.local (local) and to Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Production + Preview should both get the Supabase trio.

NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron → GET /api/cron/keep-alive (daily ping so free Supabase is not paused)
# Same value in Vercel → Environment Variables. Vercel sends Authorization: Bearer …
CRON_SECRET=

# Admin cookie + customer HMAC (use long random strings in production)
ADMIN_EMAIL=
ADMIN_DEMO_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Resend — send-only key is enough to send. Testing from=onboarding@resend.dev
# can only deliver to the Resend account inbox. To mail customers:
# 1) SMTP below (Gmail app password), or
# 2) verify subdomain send.trzywiatry.pl in Resend (keep Hostinger MX on the root).
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=
NEWSLETTER_FROM_EMAIL=Trzy Wiatry <onboarding@resend.dev>

# Gmail SMTP fallback — delivers to any customer address.
# Google Account → Security → 2FA → App passwords. Not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trzywiatrystudio@gmail.com
SMTP_PASS=
# Ops inbox for new orders, paid, contact, B2B, workshops (comma-separated ok).
# Default in code: trzywiatrystudio@gmail.com + kontakt@trzywiatry.pl
STUDIO_NOTIFY_EMAIL=

# Przelewy24
# Sandbox (test): https://sandbox.przelewy24.pl/panel → Moje dane / API
#   P24_SANDBOX=true  + klucze WYŁĄCZNIE z panelu SANDBOX
# Live (prawdziwe pieniądze): https://panel.przelewy24.pl → Konfiguracja API
#   P24_SANDBOX=false + klucze z panelu PRODUKCYJNEGO
# Klucze sandbox ≠ live. Złe API key = 401 i zamówienie bez płatności.
# PAYMENTS_ENABLED=true odblokowuje płatność w koszyku/kasie (wymaga też kluczy P24).
# Domyślnie false — klient widzi „płatności niedostępne”, nawet gdy klucze są w env.
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true
PAYMENTS_ENABLED=false
