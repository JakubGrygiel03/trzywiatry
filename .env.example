# Copy to .env.local (local) and to Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Production + Preview should both get the Supabase trio.

NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin cookie + customer HMAC (use long random strings in production)
ADMIN_EMAIL=
ADMIN_DEMO_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Resend — mail always goes to the address from the form (confirm click, orders).
# Until trzywiatry.pl DNS is verified, Resend still requires from=onboarding@resend.dev
# and can only deliver to the email on the Resend account. After DNS:
# RESEND_DOMAIN_VERIFIED=true
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=
NEWSLETTER_FROM_EMAIL=Trzy Wiatry <kontakt@trzywiatry.pl>

# Przelewy24 — leave empty until the merchant account is live
P24_MERCHANT_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true
