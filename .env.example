# Copy to .env.local (local) and to Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Production + Preview should both get the Supabase trio.

NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin cookie + customer HMAC (use long random strings in production)
ADMIN_EMAIL=
ADMIN_DEMO_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Resend — without a verified domain, from=onboarding@resend.dev and mail
# only reaches RESEND_TEST_TO (must be the Resend-account login email).
# Set RESEND_DOMAIN_VERIFIED=true after DNS for trzywiatry.pl.
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=
RESEND_TEST_TO=
NEWSLETTER_FROM_EMAIL=Trzy Wiatry <kontakt@trzywiatry.pl>

# Przelewy24 — leave empty until the merchant account is live
P24_MERCHANT_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true
